{
    "name": "marketplace",
    "version": "1.0.0",
    "description": "Full-stack E-commerce Application (React + Django + SQLite)",
    "main": "server.js",
    "scripts": {
        "server": "cd backend && python manage.py runserver 0.0.0.0:5000",
        "client": "cd frontend && npm start",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "install-all": "npm install && cd backend && python -m pip install -r requirements.txt && cd ../frontend && npm install",
        "build": "cd frontend && npm install && npm run build && cd ../backend && pip install -r requirements.txt",
        "start": "cd backend && gunicorn marketplace.wsgi:application --bind 0.0.0.0:5000",
        "lint": "npm run lint --prefix frontend",
        "lint:fix": "npm run lint:fix --prefix frontend",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run test:backend && npm run test --prefix frontend",
        "test:backend": "cd backend && python check_api.py",
        "test:frontend": "cd frontend && npm run test"
    },
    "keywords": [
        "marketplace",
        "ecommerce",
        "react",
        "django",
        "sqlite"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "concurrently": "^8.2.2",
        "prettier": "^3.5.3"
    }
}
